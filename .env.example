# StateCraft Environment Configuration
# By default, StateCraft uses its built-in Mock deterministic LLM engine,
# allowing 100% offline execution without any API keys or paid credits!
#
# To enable real commercial LLM providers, set the provider and corresponding key:

# LLM_PROVIDER options: "mock" (default), "openai", "google"
LLM_PROVIDER=mock

# OpenAI configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini configuration (Optional)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Logging and Execution Mode
STATECRAFT_LOG_LEVEL=INFO
